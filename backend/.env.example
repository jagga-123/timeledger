PORT=5000
# "development" while working locally, "production" on the host. In production an unset EMAIL_PROVIDER is an error,
# and npm run seed refuses to run.
NODE_ENV=development
# Invoices use MongoDB transactions: use a MongoDB Atlas connection string, or a local MongoDB that
# runs as a replica set (add ?replicaSet=rs0). A plain local mongod answers 503 when an invoice is created.
MONGODB_URI=mongodb://127.0.0.1:27017/timeledger
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# The address of the app in the links inside emails (/i/<token> opens an invoice without logging in).
# Leave empty to use FRONTEND_URL.
APP_URL=

# Sending invoices by email. EMAIL_PROVIDER is "console" (logs the email, sends nothing: the default while
# developing) or "brevo" (the Brevo transactional email API; needs a verified sender address, no domain).
EMAIL_PROVIDER=console
BREVO_API_KEY=replace-with-your-brevo-api-key
EMAIL_FROM=replace-with-your-verified-sender@example.com
EMAIL_FROM_NAME=TimeLedger

# The shared secret an external scheduler sends in the X-Cron-Secret header to run the payment reminders
# (POST /api/cron/reminders). Make it long and random, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# While it is empty or still this placeholder, the endpoint answers 503 and nothing runs.
CRON_SECRET=replace-with-a-long-random-string-for-the-scheduler

# The e-mail of the demo user that npm run seed creates (the password is in the README). The seed only runs against a
# local database (localhost or 127.0.0.1) and never with NODE_ENV=production, unless you also set SEED_ALLOW=true here
# or on the command line. Leave SEED_ALLOW out unless you really mean to put demo data in another database.
DEMO_EMAIL=demo@timeledger.app
# SEED_ALLOW=true

# Optional: comma-separated DNS servers Node uses to resolve mongodb+srv:// (Atlas) hosts.
# Leave empty to use the default (8.8.8.8,1.1.1.1).
DNS_SERVERS=
