PORT=5000
# Invoices use MongoDB transactions: use a MongoDB Atlas connection string, or a local MongoDB that
# runs as a replica set (add ?replicaSet=rs0). A plain local mongod answers 503 when an invoice is created.
MONGODB_URI=mongodb://127.0.0.1:27017/timeledger
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated DNS servers Node uses to resolve mongodb+srv:// (Atlas) hosts.
# Leave empty to use the default (8.8.8.8,1.1.1.1).
DNS_SERVERS=
